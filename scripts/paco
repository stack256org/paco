#!/bin/sh
# paco — operate an installed Paco instance (systemd + apt).
#
# POSIX sh. Installed to /usr/bin/paco by the .deb (see
# packaging/build-deb.sh — not this file's namesake
# packaging/paco-entrypoint.sh, which is what the systemd unit actually
# execs). Every subcommand below assumes what the .deb's maintainer scripts
# set up: a `paco.service` unit, `/etc/paco/paco.env`, and a `paco` OS user
# whose home (/var/lib/paco) holds the agent credentials.
set -eu

PACO_ETC=/etc/paco
PACO_ENV="$PACO_ETC/paco.env"
PACO_USER=paco
UNIT=paco.service
NGINX_SITE=/etc/nginx/sites-available/paco

# The instance password, as an nginx htpasswd file.
#
# Under /etc/nginx rather than /etc/paco because $PACO_ETC is 0750 root:paco
# and nginx's workers run as www-data — not in that group, and so unable even
# to traverse into it. /etc/nginx is 0755 root:root, so www-data gets there,
# and the file's group-read bit is what lets it read this.
#
# Overridable so the test suite can point it at a temporary path; see the
# /etc/* guard in cmd_password for why that does not weaken the root check.
NGINX_HTPASSWD="${PACO_HTPASSWD:-/etc/nginx/paco.htpasswd}"

fail() {
  echo "paco: $1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: paco <command>

  upgrade    Update the package: apt-get update && apt-get install
             --only-upgrade paco. Same package manager, same trust model as
             every other package on this host — there is no separate
             mechanism to keep in sync.
  logs       Follow the service's journal (journalctl -u paco -f). Extra
             arguments are passed through, e.g. `paco logs -n 200`.
  restart    systemctl restart paco. Re-reads /etc/paco/paco.env — run this
             after hand-editing that file (e.g. APP_URL, SMTP_*).
  status     Unit state, installed version, configured domain, whether the
             bundled Claude Code CLI is present, whether the paco user is
             authenticated with it, and how Poolside is (or is not) signed in.
  auth [PROVIDER] [ARGS...]
             Sign the paco user in to an agent backend, so the credential is
             written under /var/lib/paco — the one thing `dpkg` never touches
             on upgrade or `remove`. Requires root.

             paco auth           Unchanged: the same as `paco auth claude`.
             paco auth claude    `claude auth login`. That CLI ships inside
                                 this package, so a missing one means a
                                 broken install, not something to go fetch.
             paco auth poolside  `pool login`, Poolside's own sign-in. You
                                 install `pool` yourself — Paco does not ship,
                                 download or build it — so a missing one is
                                 something to install, not a broken package.
                                 Signs in the very binary your turns run: the
                                 absolute path from Settings → Models →
                                 Poolside if one is set there, otherwise
                                 whatever `pool` is on the paco user's PATH.
                                 Extra arguments are passed through to
                                 `pool login`, e.g. `paco auth poolside
                                 --api-url https://tenant.example` for an
                                 enterprise tenant.

             Neither needs a restart afterwards. Each turn spawns a fresh CLI
             process that reads the credential off disk as it starts.
  password   Set the password protecting this instance, asked for by the
             browser as user `paco`. Requires root.

             paco password           Prompts twice, with echo off.
             paco password --stdin   Reads the password from stdin, for
                                     scripts and for install.sh.

             Takes effect immediately — nginx re-reads the password file on
             every request, so there is nothing to restart. Browsers holding
             the old password are asked again on their next request; that is
             what replaces signing out.
  tls DOMAIN Obtain and install a certificate for DOMAIN with certbot's
             nginx plugin (the HTTP-01 challenge, served on port 80), then
             reload nginx. Requires root.

             Refuses first, before installing certbot or touching anything,
             if DOMAIN does not already resolve to an address on this host —
             the HTTP-01 challenge is served here, so pointing it at a name
             that resolves elsewhere fails with an error that reads like a
             certbot bug rather than a DNS mistake. Safe to re-run for a
             domain that already has a certificate: an unexpired one is left
             alone, a soon-to-expire one is renewed.

             Certificates are issued per hostname, over HTTP-01 only: there
             is no wildcard certificate and no DNS-provider credential to
             configure. That means a preview hostname
             (<slug>.<preview base domain>, see Settings → Domain) is its
             own separate hostname and needs its own certificate — this
             command only ever covers the one DOMAIN you pass it, never
             every preview at once.

There is no `uninstall`. Use `apt remove paco` to stop Paco and keep
/etc/paco and /var/lib/paco, or `apt purge paco` to also destroy them.
EOF
}

require_root() {
  [ "$(id -u)" = "0" ] || fail "'$1' must run as root (try: sudo paco $1)."
}

# Reads one KEY from paco.env without ever sourcing it — a stray `$(...)` or
# unbalanced quote in a hand-edited value would otherwise execute as root
# the moment any subcommand below ran.
env_get() {
  [ -f "$PACO_ENV" ] || return 0
  sed -n "s/^$1=//p" "$PACO_ENV" | tail -1
}

# Read one value out of the `instance_settings` row the app writes from
# Settings, the same way configured_domain() below reaches Postgres: as the
# paco OS user, over the Unix socket, via peer auth. $1 is the expression to
# select, $2 the column that has to be set for the row to count.
#
# Empty output means any of "not configured", "no database", "not root" — and
# every caller here treats all three identically on purpose. In each of them
# this value only ever *refines* an answer (which `pool` to sign in, whether
# to add a warning); none of them decides anything on its absence, so a
# missing database degrades to the PATH default rather than to an error about
# Postgres from a command that was not asked about Postgres.
instance_setting() {
  [ "$(id -u)" = "0" ] || return 0
  id "$PACO_USER" >/dev/null 2>&1 || return 0
  setting_raw=$(su -s /bin/sh "$PACO_USER" -c \
    "psql -U paco -d paco -tAc \"SELECT $1 FROM instance_settings WHERE $2 IS NOT NULL LIMIT 1\"" \
    2>/dev/null) || return 0
  printf '%s' "$setting_raw" | tr -d '\n\r'
}

# --- upgrade -----------------------------------------------------------------

cmd_upgrade() {
  require_root upgrade
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install --only-upgrade -y paco
}

# --- logs ----------------------------------------------------------------------

cmd_logs() {
  journalctl -u paco -f "$@"
}

# --- restart -------------------------------------------------------------------

cmd_restart() {
  require_root restart
  systemctl restart "$UNIT"
}

# --- auth ------------------------------------------------------------------
#
# Two backends, two credentials, one shape. Both write into /var/lib/paco —
# the directory `dpkg` never touches on upgrade or `apt remove` — and neither
# needs a restart afterwards, because a turn spawns a fresh CLI process that
# reads the credential off disk as it starts.
#
# They differ in exactly one way that matters to the operator, and every
# message below turns on it: `claude` is bundled in this package, so a
# missing one is a broken install; `pool` is not, so a missing one is
# something to go and install.

require_paco_user() {
  id "$PACO_USER" >/dev/null 2>&1 \
    || fail "the '$PACO_USER' user does not exist — is paco installed? See install.sh."
}

# Refuse a value that would break out of the single quotes every `su -c`
# below wraps it in. Only ever reached by a path an admin typed into
# Settings, so it is a typo guard, not a security boundary — but a `pool`
# path containing a quote would otherwise run the rest of itself as a command
# in the service user's shell.
reject_quote() {
  case "$1" in
    *\'*) fail "$2" ;;
  esac
}

auth_claude() {
  require_root auth
  require_paco_user
  if ! su -s /bin/sh -l "$PACO_USER" -c 'command -v claude' >/dev/null 2>&1; then
    fail "the 'claude' CLI is not on PATH for the '$PACO_USER' user. It ships bundled in the package (/usr/bin/claude) — this means the install is broken. Try 'sudo apt-get install --reinstall paco', then re-run 'paco auth'."
  fi
  echo "paco: running 'claude auth login' as $PACO_USER — the credential lands in /var/lib/paco/.claude and survives every future upgrade or 'apt remove'."
  su -s /bin/sh -l "$PACO_USER" -c 'claude auth login'
}

# The `pool` this host should sign in, which is deliberately the same one
# every Poolside turn already runs: the absolute path an admin put in
# Settings → Models → Poolside (which lib/agent/backend-factory.ts hands the
# backend as `executable`), else the bare name for the service user's PATH to
# resolve. Signing in some other `pool` on the host is the trap this avoids —
# the operator would watch a login succeed and every turn keep failing.
poolside_binary() {
  poolside_configured="$(instance_setting poolside_binary_path poolside_binary_path)"
  if [ -n "$poolside_configured" ]; then
    printf '%s' "$poolside_configured"
  else
    printf 'pool'
  fi
}

# Where `pool` keeps its credential for a given user, asked of the binary
# rather than assumed: `pool config` prints a `credentials file:` line, and
# it honours HOME/XDG_CONFIG_HOME, so run as the service user it names the
# service user's file. Empty if the binary does not report one — every caller
# falls back to naming the directory instead of printing a blank path.
poolside_credentials_file() {
  su -s /bin/sh -l "$PACO_USER" -c "'$1' config" 2>/dev/null \
    | sed -n 's/^credentials file: //p' | tail -1
}

auth_poolside() {
  require_root "auth poolside"
  require_paco_user

  pool_bin="$(poolside_binary)"
  reject_quote "$pool_bin" \
    "the Poolside binary path in Settings → Models → Poolside contains a single quote. Move the binary somewhere without one and update that field, then re-run 'sudo paco auth poolside'."

  if ! su -s /bin/sh -l "$PACO_USER" -c "command -v '$pool_bin'" >/dev/null 2>&1; then
    if [ "$pool_bin" = "pool" ]; then
      fail "the 'pool' CLI is not on PATH for the '$PACO_USER' user. Paco does not ship, download or build it — unlike the bundled Claude CLI, this is not a broken install. Install it with Poolside's own installer (https://poolside.ai), then re-run 'sudo paco auth poolside'. If it is already installed somewhere the service user's PATH does not reach — systemd's PATH is not your login shell's — put its absolute path in Settings → Models → Poolside → Binary path and re-run this; that field is what your turns use, and so is what this command signs in."
    fi
    fail "'$pool_bin' — the binary path set in Settings → Models → Poolside — is not runnable by the '$PACO_USER' user. Every Poolside turn runs that same path, so it is failing too. Fix it there (or clear the field to fall back to whatever 'pool' is on PATH), then re-run 'sudo paco auth poolside'."
  fi

  # Extra arguments go through to `pool login` verbatim — `--api-url` for an
  # enterprise tenant, `--api-key` for a key you would rather not paste into
  # Settings. Re-quoted one at a time because this crosses a `su -c` shell.
  #
  # Verified on Debian (systemd 257 image, real `su`), against a service user
  # shaped like the packaged one — system account, `/usr/sbin/nologin` shell:
  # `su -s /bin/sh -l` still reaches that user's own PATH, `pool` runs as
  # `paco`, `--api-url https://tenant.example.com` arrives intact, and an
  # argument of `$(id -un)x` arrives as those literal characters rather than
  # being executed. macOS `su` has no `-s`, which is why this could not be
  # checked on the host it was written on.
  pool_args=""
  for pool_arg in "$@"; do
    reject_quote "$pool_arg" \
      "arguments to 'paco auth poolside' cannot contain a single quote — they cross a shell on the way to '$pool_bin login'."
    pool_args="$pool_args '$pool_arg'"
  done

  pool_creds="$(poolside_credentials_file "$pool_bin")"
  if [ -n "$pool_creds" ]; then
    echo "paco: running '$pool_bin login' as $PACO_USER — the credential lands in $pool_creds and survives every future upgrade or 'apt remove'."
  else
    echo "paco: running '$pool_bin login' as $PACO_USER — the credential lands under that user's home (/var/lib/paco/.config/poolside) and survives every future upgrade or 'apt remove'."
  fi
  echo "paco: follow whatever '$pool_bin login' asks for below; Paco does not drive it."

  su -s /bin/sh -l "$PACO_USER" -c "'$pool_bin' login$pool_args"

  echo "paco: done — and there is nothing to restart. Every Poolside turn spawns a fresh '$pool_bin' process which reads this credential off disk as it starts, so the next turn picks it up."
  if [ -n "$(instance_setting 1 poolside_api_key_sealed)" ]; then
    echo "paco: NOTE — an API key is also stored in Settings → Models → Poolside. It reaches every turn as POOLSIDE_API_KEY, and that takes precedence over the credential you just wrote. Clear that field if you want this login to be the thing your turns use." >&2
  fi
}

cmd_auth() {
  # Bare `paco auth` keeps the meaning it has always had, and the meaning
  # docs/self-hosting.md §3 documents: sign in to Claude. The provider is a
  # new, optional first argument rather than a new command, so nothing an
  # operator has in a runbook changes.
  provider="${1:-claude}"
  if [ $# -gt 0 ]; then
    shift
  fi

  case "$provider" in
    claude)
      [ $# -eq 0 ] || fail "'paco auth claude' takes no arguments. (Did you mean 'paco auth poolside $*'? That one does forward them.)"
      auth_claude
      ;;
    poolside) auth_poolside "$@" ;;
    *)
      fail "unknown auth provider: '$provider'. Use 'paco auth claude' (what bare 'paco auth' has always meant, and still does) or 'paco auth poolside'."
      ;;
  esac
}

# --- tls ---------------------------------------------------------------------
#
# `install.sh` only ever prints http://; the plan names certbot but nothing
# wired it up. This is that wiring, for one hostname at a time — the app's
# own domain, set in Settings, not previews (see the help text in usage()).

# This host's own addresses, best-effort: the private/internal address
# `hostname -I` and `ip` see, plus (for a cloud VM behind NAT, where DNS
# points at a public address neither of those knows about) the same
# short-timeout public-address lookups install.sh already uses for its
# domain prompt. Any single one of these matching what DOMAIN resolves to is
# enough — see cmd_tls.
local_addresses() {
  {
    hostname -I 2>/dev/null
    ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1
    curl -fsS --max-time 3 http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null
    curl -fsS --max-time 3 https://ifconfig.me 2>/dev/null
    echo
  } | tr ' ' '\n' | sed '/^$/d' | sort -u
}

# What DOMAIN resolves to right now, one address per line. `getent` reads
# the same resolver configuration and NSS chain the rest of the system does,
# without depending on `dig`/`host` being installed.
resolved_addresses() {
  getent ahosts "$1" 2>/dev/null | awk '{print $1}' | sort -u
}

cmd_tls() {
  domain="${1:-}"
  if [ -z "$domain" ] || [ $# -gt 1 ]; then
    echo "Usage: paco tls <domain>" >&2
    echo "See 'paco help' for what this does and does not cover (one hostname, no wildcard, previews excluded)." >&2
    exit 1
  fi
  require_root tls

  # Let's Encrypt does not issue certificates for bare IP addresses — fail
  # before any of the DNS-resolution work below, with a message that says
  # so plainly rather than however certbot itself would phrase it.
  case "$domain" in
    *[!0-9.]*) : ;;
    *) fail "'$domain' looks like a bare IPv4 address. Let's Encrypt only issues certificates for hostnames — point a DNS name at this host and pass that instead." ;;
  esac
  case "$domain" in
    *:*) fail "'$domain' looks like an IPv6 address. Let's Encrypt only issues certificates for hostnames — point a DNS name at this host and pass that instead." ;;
  esac

  echo "paco: checking that '$domain' resolves to this host..."
  resolved="$(resolved_addresses "$domain")"
  if [ -z "$resolved" ]; then
    fail "'$domain' does not resolve to any address right now. Point DNS at this host (an A or AAAA record), then re-run 'paco tls $domain'. certbot's HTTP-01 challenge is served on port 80 at whatever address the domain resolves to — running it against a name that points elsewhere fails with an error that reads like a certbot bug, not a DNS one."
  fi

  local_ips="$(local_addresses)"
  match=0
  for ip in $resolved; do
    if printf '%s\n' "$local_ips" | grep -qx "$ip"; then
      match=1
      break
    fi
  done
  if [ "$match" -ne 1 ]; then
    echo "paco: '$domain' resolves to: $(printf '%s' "$resolved" | tr '\n' ' ')" >&2
    echo "paco: this host's own addresses: $(printf '%s' "$local_ips" | tr '\n' ' ')" >&2

    # Resolving elsewhere is not always misconfigured DNS. On a platform that
    # terminates TLS at its edge — Krova Cloud, Cloudflare's proxy, any load
    # balancer — the domain is *supposed* to point at the edge rather than at
    # this host, and HTTPS already works. Telling that operator to "fix DNS"
    # sends them to break the one thing that is set up correctly, so check
    # whether the name already serves HTTPS before blaming the records.
    # `curl` is not in the package's Depends, so check for it rather than
    # relying on a "command not found" exit status to fall through.
    if command -v curl >/dev/null 2>&1 &&
      curl -fsS -o /dev/null --max-time 10 "https://$domain/" 2>/dev/null; then
      echo "paco: https://$domain/ already works." >&2
      fail "'$domain' is already served over HTTPS by something in front of this host, which is why it resolves elsewhere — your DNS is fine and there is nothing for this command to do. Platforms that terminate TLS at their edge (Krova Cloud, Cloudflare's proxy, a load balancer) handle certificates for you. Set the domain in Settings if you have not already; skip 'paco tls'. A certificate requested here could not be validated anyway, because the HTTP-01 challenge is answered by the edge and not by this host."
    fi

    fail "'$domain' does not resolve to this host. Fix DNS, then re-run 'paco tls $domain'. If something in front of this host is meant to terminate TLS, skip this command entirely — it is only for a host reachable at its own public address."
  fi
  echo "paco: '$domain' resolves here — proceeding."

  # Only after the DNS check passes — installing a package to then refuse
  # to use it is worse than not installing it at all.
  if ! command -v certbot >/dev/null 2>&1; then
    echo "paco: installing certbot"
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y certbot python3-certbot-nginx
  fi

  # Make sure the site certbot has to edit actually names this domain.
  # Without this, certbot's nginx plugin can't match `server_name _;`
  # against a real hostname and creates a second, competing server block
  # instead of augmenting this one. Skipped once the domain is already
  # there — the same re-run this whole command is meant to be a no-op for.
  if [ -f "$NGINX_SITE" ] && ! grep -q "$domain" "$NGINX_SITE"; then
    echo "paco: adding '$domain' to $NGINX_SITE"
    original="$(cat "$NGINX_SITE")"
    tmp_site="$NGINX_SITE.tmp.$$"
    sed "s/^\([[:space:]]*server_name \)_;/\1_ $domain;/" "$NGINX_SITE" > "$tmp_site"
    mv "$tmp_site" "$NGINX_SITE"
    if ! nginx -t >/dev/null 2>&1; then
      printf '%s\n' "$original" > "$NGINX_SITE"
      fail "adding '$domain' to $NGINX_SITE produced an invalid nginx config; left the file unchanged. Check $NGINX_SITE by hand."
    fi
  fi

  echo "paco: requesting a certificate for '$domain' via certbot..."
  # --register-unsafely-without-email: no admin address is on hand here to
  # pass as -m (paco.env holds no such thing) — renewal itself is automatic
  # regardless (certbot's own systemd timer/cron job), so the only real cost
  # is not getting Let's Encrypt's own expiry-reminder email. --nginx finds
  # (or, per above, now finds) the server block for $domain, installs the
  # certificate into it, adds the redirect, and reloads nginx itself on
  # success. No --force-renewal: an existing, unexpired certificate for
  # $domain is left alone rather than reissued, which is what makes running
  # this again for the same domain a no-op instead of an error.
  certbot --nginx -d "$domain" \
    --non-interactive --agree-tos --register-unsafely-without-email --redirect \
    || fail "certbot failed for '$domain' — see its output above."

  if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx || systemctl restart nginx
  else
    echo "paco: WARNING — nginx's config test failed after certbot ran. Check 'nginx -t' by hand; nginx was not reloaded." >&2
  fi

  echo "paco: certificate for '$domain' is installed; nginx now serves it on 443 and redirects 80 to it."
  echo "paco: if '$domain' is this instance's own domain, also set APP_URL=https://$domain in $PACO_ENV (or in Settings) and run 'paco restart', so links and redirects use https too."
}

# --- status ------------------------------------------------------------------

unit_state() {
  state=$(systemctl is-active "$UNIT" 2>/dev/null) || state="inactive"
  enabled=$(systemctl is-enabled "$UNIT" 2>/dev/null) || enabled="not enabled"
  echo "$state ($enabled)"
}

installed_version() {
  version=$(dpkg-query -W -f='${Version}' paco 2>/dev/null) || version="not installed"
  echo "$version"
}

# APP_URL in paco.env, if the operator (or install.sh's --domain) set one,
# else the domain saved from Settings (instance_settings.app_domain),
# queried the same way the paco.service process itself would reach
# Postgres: as the paco OS user, over the Unix socket, via peer auth.
configured_domain() {
  app_url="$(env_get APP_URL)"
  if [ -n "$app_url" ]; then
    echo "$app_url (set in $PACO_ENV)"
    return 0
  fi

  if [ "$(id -u)" != "0" ]; then
    echo "unknown (run as root to check Settings — no APP_URL set in $PACO_ENV)"
    return 0
  fi
  if ! id "$PACO_USER" >/dev/null 2>&1; then
    echo "unknown (the $PACO_USER user does not exist)"
    return 0
  fi

  if domain_raw=$(su -s /bin/sh "$PACO_USER" -c \
    "psql -U paco -d paco -tAc \"SELECT app_domain FROM instance_settings WHERE app_domain IS NOT NULL LIMIT 1\"" \
    2>/dev/null); then
    domain="$(printf '%s' "$domain_raw" | tr -d '[:space:]')"
    if [ -n "$domain" ]; then
      echo "$domain (saved in Settings)"
    else
      echo "not configured (reachable on this host's address)"
    fi
  else
    echo "unknown (could not query Postgres - is it running?)"
  fi
}

# Whether the bundled Claude Code CLI (/usr/bin/claude, see
# packaging/claude-wrapper.sh) is actually on PATH for the paco user.
# Checked separately from authentication below: a missing CLI means the
# package itself is broken (postinst already warns about this at install
# time — see packaging/debian/postinst) and no amount of 'paco auth' fixes
# it, so the two must never be collapsed into one line that only ever says
# "no" without saying which problem it is.
claude_cli_present() {
  if [ "$(id -u)" != "0" ]; then
    echo "unknown (run as root to check)"
    return 0
  fi
  if ! id "$PACO_USER" >/dev/null 2>&1; then
    echo "unknown (the $PACO_USER user does not exist)"
    return 0
  fi
  if su -s /bin/sh -l "$PACO_USER" -c 'command -v claude' >/dev/null 2>&1; then
    echo "yes"
  else
    echo "no (bundled CLI missing - the install is broken; try 'sudo apt-get install --reinstall paco')"
  fi
}

claude_auth_state() {
  if [ "$(id -u)" != "0" ]; then
    echo "unknown (run as root to check)"
    return 0
  fi
  if ! id "$PACO_USER" >/dev/null 2>&1; then
    echo "unknown (the $PACO_USER user does not exist)"
    return 0
  fi
  if ! su -s /bin/sh -l "$PACO_USER" -c 'command -v claude' >/dev/null 2>&1; then
    echo "unknown (CLI not present - see 'CLI:' above)"
    return 0
  fi
  if su -s /bin/sh -l "$PACO_USER" -c 'claude auth status' >/dev/null 2>&1; then
    echo "yes"
  else
    echo "no (run 'sudo paco auth')"
  fi
}

# Whether the paco user can sign a Poolside turn in, and how.
#
# Deliberately weaker than claude_auth_state() above, because `pool` has no
# equivalent of `claude auth status` to ask (`pool --help` lists login and
# logout, and nothing that reports state). What can be checked without
# spending a turn is that the credential FILE `pool config` names exists —
# so that is what this says, in those words. A stored file that the service
# has since rejected still reads as present here; the first turn is what
# proves it.
#
# The API key in Settings is reported alongside rather than instead: it is
# the other way to authenticate, it takes precedence over this file, and an
# instance configured that way is correctly configured with no login at all.
poolside_state() {
  if [ "$(id -u)" != "0" ]; then
    echo "unknown (run as root to check)"
    return 0
  fi
  if ! id "$PACO_USER" >/dev/null 2>&1; then
    echo "unknown (the $PACO_USER user does not exist)"
    return 0
  fi

  # An `a && b` list here would abort the whole function under `set -eu` on
  # the ordinary "no key stored" path, and this runs inside a command
  # substitution, so the failure would surface as a blank status line.
  poolside_key=""
  if [ -n "$(instance_setting 1 poolside_api_key_sealed)" ]; then
    poolside_key="yes"
  fi

  status_bin="$(poolside_binary)"
  case "$status_bin" in
    *\'*)
      echo "unknown (the binary path in Settings contains a single quote)"
      return 0
      ;;
  esac
  if ! su -s /bin/sh -l "$PACO_USER" -c "command -v '$status_bin'" >/dev/null 2>&1; then
    echo "not installed ('$status_bin' is not runnable by the $PACO_USER user - Paco does not ship it; see 'paco auth poolside')"
    return 0
  fi

  status_creds="$(poolside_credentials_file "$status_bin")"
  if [ -n "$status_creds" ] && [ -f "$status_creds" ]; then
    if [ -n "$poolside_key" ]; then
      echo "credential file present ($status_creds), but an API key in Settings takes precedence over it"
    else
      echo "credential file present ($status_creds)"
    fi
    return 0
  fi
  if [ -n "$poolside_key" ]; then
    echo "no login, using the API key in Settings"
    return 0
  fi
  echo "no (run 'sudo paco auth poolside', or set an API key in Settings)"
}

# Whether this instance is still using the password postinst generated.
#
# The marker file is what distinguishes the two, not the hash: a bcrypt hash
# cannot be compared against anything without the original. `paco password`
# deletes the marker, so its presence means "generated, never changed".
password_state() {
  if [ ! -f "$NGINX_HTPASSWD" ]; then
    echo "NOT SET - this instance is unprotected. Run 'sudo paco password'."
    return 0
  fi

  if [ -f "$PACO_ETC/initial-password" ]; then
    echo "set (still the one generated at install; change with 'sudo paco password')"
    return 0
  fi

  echo "set"
}

cmd_status() {
  echo "Unit:      $(unit_state)"
  echo "Version:   $(installed_version)"
  echo "Domain:    $(configured_domain)"
  echo "Password:  $(password_state)"
  echo "CLI:       $(claude_cli_present)"
  echo "Claude:    $(claude_auth_state)"
  echo "Poolside:  $(poolside_state)"
}

# --- password ----------------------------------------------------------------

read_password_twice() {
  [ -t 0 ] || fail "password: no terminal to prompt on. Use 'paco password --stdin'."

  printf 'New password for this Paco instance: '
  stty -echo 2>/dev/null || true
  IFS= read -r new_password || true
  stty echo 2>/dev/null || true
  printf '\n'

  printf 'Confirm: '
  stty -echo 2>/dev/null || true
  IFS= read -r confirm_password || true
  stty echo 2>/dev/null || true
  printf '\n'

  [ "$new_password" = "$confirm_password" ] \
    || fail "password: the two entries did not match. Nothing was changed."
}

cmd_password() {
  use_stdin=0
  case "${1:-}" in
    --stdin) use_stdin=1 ;;
    "") ;;
    *) fail "password: unknown argument: $1" ;;
  esac

  # Root is required to write the real file under /etc, and only for that.
  # A run pointed somewhere writable by $PACO_HTPASSWD needs no privilege,
  # which is what makes this command testable without weakening the check:
  # the guard is on the path actually being written, not on an opt-out flag.
  case "$NGINX_HTPASSWD" in
    /etc/*) require_root password ;;
  esac

  command -v htpasswd >/dev/null 2>&1 \
    || fail "password: htpasswd not found. Install apache2-utils."

  new_password=""
  confirm_password=""

  if [ "$use_stdin" -eq 1 ]; then
    IFS= read -r new_password || true
  else
    read_password_twice
  fi

  [ -n "$new_password" ] || fail "password: an empty password is not allowed."

  # -i reads the password from stdin. `htpasswd -b` would put it in argv,
  # where `ps` shows it to every user on this machine. -B is bcrypt, which
  # nginx reads and `openssl passwd` cannot produce. -c truncates, which is
  # what we want: this file holds exactly one entry and rotating replaces it.
  umask 027
  printf '%s' "$new_password" \
    | htpasswd -i -B -c "$NGINX_HTPASSWD" paco >/dev/null 2>&1 \
    || fail "password: htpasswd failed to write $NGINX_HTPASSWD."

  # Best-effort: fails harmlessly when this is a test run as a normal user.
  chown root:www-data "$NGINX_HTPASSWD" 2>/dev/null || true
  chmod 640 "$NGINX_HTPASSWD"

  # The generated password is no longer a fact about this system.
  rm -f "$PACO_ETC/initial-password"

  # No `systemctl reload`: nginx reads auth_basic_user_file per request, so
  # this is already in effect. Browsers holding the old password start
  # getting 401s and re-prompt on their own — that is the re-authentication.
  echo "paco: password updated. Browsers will ask for it again on their next request."
}

# --- dispatch ----------------------------------------------------------------

command="${1:-}"
if [ $# -gt 0 ]; then
  shift
fi

case "$command" in
  upgrade) cmd_upgrade ;;
  logs) cmd_logs "$@" ;;
  restart) cmd_restart ;;
  status) cmd_status ;;
  auth) cmd_auth "$@" ;;
  password) cmd_password "$@" ;;
  tls) cmd_tls "$@" ;;
  uninstall)
    echo "paco: there is no uninstall." >&2
    echo "'apt remove paco' stops Paco and keeps /etc/paco and /var/lib/paco (including the Claude and Poolside credentials and every workspace)." >&2
    echo "'apt purge paco' also destroys /etc/paco and /var/lib/paco — see docs/self-hosting.md before running it." >&2
    exit 1
    ;;
  "" | help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    fail "unknown command: $command"
    ;;
esac
