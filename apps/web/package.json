{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm db:migrate:apply && next build",
    "db:migrate:apply": "node lib/db/migrate.ts && node scripts/workflow-bootstrap.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "node scripts/check-migrations.ts",
    "workflow:bootstrap": "node scripts/workflow-bootstrap.ts",
    "workflow:inspect": "pnpm dlx workflow inspect runs --backend @workflow/world-postgres"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@base-ui/react": "1.6.0",
    "@paco/agent-backend": "workspace:*",
    "@paco/claude-code": "workspace:*",
    "@paco/plugin-host": "workspace:*",
    "@paco/plugin-kit": "workspace:*",
    "@paco/poolside-backend": "workspace:*",
    "@paco/sandbox": "workspace:*",
    "@paco/shared": "workspace:*",
    "@pierre/diffs": "^1.0.10",
    "@pierre/trees": "^1.0.0-beta.3",
    "@streamdown/code": "^1.1.1",
    "@swc/helpers": "0.5.23",
    "@workflow/ai": "4.2.0",
    "@workflow/world-postgres": "4.3.3",
    "ai": "catalog:",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "cron-parser": "^5.7.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "nodemailer": "^9.0.3",
    "pg-boss": "^12.27.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "streamdown": "^2.5.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.4.0",
    "undici": "7.28.0",
