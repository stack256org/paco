# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string. The only one: Drizzle, pg-boss and the durable
# workflow runtime all use it.
#
# Under docker compose the host is the service name, not localhost:
#   postgres://paco:paco@postgres:5432/paco
POSTGRES_URL=

# Signs auth sessions, and derives the key that encrypts stored GitHub tokens.
# Changing it invalidates both. Generate one with: openssl rand -base64 32
#
# Back this up with the database. A dump restored under a different APP_SECRET
# leaves every stored GitHub token permanently undecryptable, and every user has
# to reconnect. See docs/self-hosting.md.
APP_SECRET=

# ---------------------------------------------------------------------------
# Email (magic-link sign-in)
# ---------------------------------------------------------------------------
# Any SMTP provider. Leave SMTP_HOST unset and sign-in links are logged to the
# server console instead of being sent, which is enough for local development.
#
# Local testing with Mailpit:
#   mailpit            # SMTP on :1025, web UI on http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
# Defaults to true on port 465, false otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Paco <no-reply@localhost>"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# The public origin this app is served on, scheme and port included.
#
# A fresh install has no domain yet, and Paco falls back to
# http://localhost:3000 (or http://localhost:$PORT, if PORT is set) when this
# is unset. Set it once you have a real address — magic-link URLs, pull-request
# links, the origins better-auth will accept a sign-in callback from, and the
# port `pnpm dev` listens on are all derived from it.
#
# Left commented out on purpose: a compose deploy that just fills in
# POSTGRES_URL and APP_SECRET and runs `docker compose up -d` must not come up
# permanently pinned to a developer's own localhost address. Uncomment it only
# for a value you actually want fixed in the environment; otherwise configure
# the domain from Settings once Paco is running, or set it locally to
# http://localhost:3066 to avoid clashing with the dev servers agents start
# inside sandboxes, which commonly claim :3000 themselves.
# APP_URL=http://localhost:3066

# Host directory holding sandbox workspaces. Defaults to ~/.paco/workspaces.
#
# Set this when running Paco itself in a container: it creates sandboxes as
# sibling containers through the host's Docker socket, so this path has to mean
# the same thing inside Paco and on the host. Bind-mount it at the identical
# path in both. See the repository README.
# PACO_WORKSPACE_ROOT=

# ---------------------------------------------------------------------------
# Nothing else to configure
# ---------------------------------------------------------------------------
# GitHub  — through the `gh` CLI, which must be on PATH. Connect an account in
#           Settings -> Connections; the token is sealed with APP_SECRET and stored
#           in the database. No GitHub App, no webhook, no credentials here.
# Agent   — the `claude` CLI, which must be on PATH, authenticated once with
#           `claude auth login`. Uses your subscription; no API key.
# Sandbox — the `ghcr.io/stack256org/paco-sandbox:latest` image, pulled on first
#           use. Override with PACO_SANDBOX_IMAGE to use a mirror, or a local
#           build:  docker build -t <your-tag> packages/sandbox/docker
#
# And two variables Paco sets for itself, which an operator must NOT set here.
# An older .env may still carry them; delete them rather than leaving a value
# that is either overwritten or ignored:
#
#   WORKFLOW_POSTGRES_URL — overwritten with POSTGRES_URL by lib/db/migrate.ts,
#                           and ignored at runtime (instrumentation.ts builds
#                           the workflow world from POSTGRES_URL directly).
#   WORKFLOW_TARGET_WORLD — assigned in next.config.ts; always
#                           @workflow/world-postgres.
#
# Operating an instance — backup and restore, sign-ups, upgrades, disk, ports:
#   docs/self-hosting.md
