[Unit]
Description=Paco
# docker.socket and docker.service are ordered against, and docker.service is
# pulled in, because every chat opens /var/run/docker.sock and that socket does
# not exist until Docker has started. Without this Paco could win the boot race
# and come up first, and then every chat failed with "Cannot connect to the
# Docker daemon" until something happened to retry — intermittent precisely
# because it was a race. docker.socket is listed as well as docker.service
# because on a socket-activated install it is the unit that creates the socket
# file.
After=network-online.target postgresql.service docker.socket docker.service
Wants=network-online.target docker.service
Requires=postgresql.service

# Wants=, not Requires=, and the difference is deliberate rather than an
# oversight next to postgresql.service's Requires= below.
#
# Requires= is a lifecycle coupling, not an ordering: systemd stops this unit
# whenever the required one stops. `apt upgrade` of docker.io restarts
# docker.service, and a Requires= would take Paco down with it — including the
# web UI, Settings, and every page that has nothing to do with a container —
# and leave it down, because a restart of the required unit does not bring the
# dependent one back. Requires= also refuses to start Paco at all on a host
# where Docker failed to start, turning "chats fail with a clear message" into
# "the product does not come up".
#
# Wants= + After= buys the whole of what is needed: docker.service is started
# alongside Paco, Paco is ordered after it, and neither a Docker restart nor a
# Docker that is missing entirely (docker is Recommends, not Depends — see
# packaging/debian/control) can stop Paco from running. A missing unit makes
# Wants= a no-op rather than an error, which is what makes this safe to state
# unconditionally here.
#
# postgresql.service keeps Requires= for the opposite reason: Postgres is not
# a per-feature dependency. paco-entrypoint.sh runs migrations against it
# before the server starts and every page reads from it, so a Paco without
# Postgres has nothing to serve. Docker is needed per chat, and a chat that
# cannot start already explains itself (apps/web/lib/sandbox/setup-failure-copy.ts
# turns an unreachable daemon into "start it with sudo systemctl start docker").
#
# Verified by systemd itself: `systemd-analyze verify` on systemd 257
# (debian:stable-slim, in a container, with stub postgresql/docker units and
# the entrypoint present) exits 0 with no diagnostics. That covers the syntax
# and every directive name here. The RUNTIME ordering claimed above is
# reasoned from systemd.unit(5)'s definitions of After=/Wants=/Requires=,
# which verify does not exercise — it is the documented behaviour, not a
# guess about an implementation, but it has not been watched happen on a
# real boot.

[Service]
Type=simple
User=paco
Group=paco
WorkingDirectory=/usr/lib/paco
# Next's standalone server defaults to binding 0.0.0.0 when HOSTNAME is
# unset. The instance password lives entirely in nginx's auth_basic — the
# app has no application-level authentication of its own (see
# docs/agents' Authentication note) — so a process listening on every
# interface lets anyone on the network reach it on :3000 directly, skipping
# nginx and the password it holds. Binding loopback forces every request
# through nginx. dpkg replaces this unit on every upgrade, so this line is
# what repairs an already-installed instance; packaging/debian/postinst
# sets the same thing for a fresh install. An operator who deliberately
# wants the app reachable off-loopback (no nginx in front, for example)
# must remove this line knowingly.
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/etc/paco/paco.env
# The installed package's version, generated into the package by
# packaging/build-deb.sh. Read second so an operator can still override
# anything here from paco.env, and marked optional with `-` so a host upgraded
# from a package that predates the file starts normally instead of failing on a
# missing EnvironmentFile.
#
# It carries PACO_VERSION, which pins the sandbox image to the one built
# alongside this exact package (see packages/sandbox/docker/config.ts). It has
# to ship IN the package rather than live in paco.env, because paco.env is
# generated once and never rewritten — a version pinned there would freeze at
# whatever was installed first and never move again.
EnvironmentFile=-/usr/lib/paco/version.env
# Not a bare `node .../server.js`: migrations have to run at service start
# (see postinst, and docs/agents/native-installation notes) rather than from
# a maintainer script, so that a migration failure surfaces as a failed
# `systemctl start paco` — visible and retryable — instead of aborting an
# `apt upgrade` partway through, or silently skipping migrations altogether.
# `/usr/lib/paco/paco-entrypoint.sh` (packaging/paco-entrypoint.sh, installed
# under that name — deliberately NOT /usr/bin/paco, which is the operator
# CLI installed from scripts/paco; see packaging/build-deb.sh) runs
# `lib/db/migrate.ts` against the same `apps/web/.next/standalone` output the
# systemd unit itself serves, then execs `node server.js` in place — so this
# is the one process systemd tracks, restarts, and can send signals to.
ExecStart=/usr/lib/paco/paco-entrypoint.sh
Restart=always
RestartSec=5
StateDirectory=paco

# No sandboxing directives (ProtectSystem=strict, PrivateTmp, NoNewPrivileges,
# etc.) are added here. None of them were tested against a real chat — this
# package is not installed on any machine as part of building it (see
# packaging/build-deb.sh and the native-installation task notes), and adding
# a directive without running a real chat through it is exactly how one of
# these breaks Paco silently at the first sandbox:
#   - ProtectSystem=strict / ProtectHome would make most of the filesystem
#     read-only, including /var/lib/paco/workspaces, which Paco writes chat
#     worktrees into, and could interfere with reaching
#     /var/run/docker.sock depending on its group and how it's mounted.
#   - NoNewPrivileges could block whatever re-exec or setuid path a given
#     distribution's `docker.io` packaging relies on for group membership.
# If a future change adds any of these, test a real chat end-to-end first
# (a sandbox created, a command run in it, the container reaped) and record
# which directives were tried and with what result — an untested guess at
# "this one is probably fine" is not a basis for shipping it.

[Install]
WantedBy=multi-user.target
