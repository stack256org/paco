#!/bin/sh
# postinst runs on every install AND every upgrade — every step below has to
# be a no-op the second time it runs, or an `apt upgrade` would silently
# redo something that must only ever happen once (regenerating APP_SECRET
# chief among them: it derives the key that encrypts every stored GitHub
# token, so regenerating it on upgrade would silently and permanently
# orphan every one of them).
set -e

PACO_ETC=/etc/paco
PACO_ENV="$PACO_ETC/paco.env"
PACO_HOME=/var/lib/paco
PACO_USER=paco
PACO_GROUP=paco
NGINX_SITE=/etc/nginx/sites-available/paco
NGINX_ENABLED=/etc/nginx/sites-enabled/paco
# The instance password, as an nginx htpasswd file. Under /etc/nginx and not
# /etc/paco because $PACO_ETC is 0750 root:paco and nginx's workers are
# www-data, which cannot traverse into it.
NGINX_HTPASSWD=/etc/nginx/paco.htpasswd
# Where Paco itself writes generated preview-routing server blocks
# (apps/web/lib/preview/nginx-reload.ts) — a directory it owns outright,
# rather than loosening permissions on /etc/nginx/conf.d, which stays
# root:root throughout. Pulled into nginx's config by the small, static,
# root-owned include file below (step 5).
PACO_NGINX_DIR=/etc/paco/nginx
NGINX_PREVIEWS_INCLUDE=/etc/nginx/conf.d/paco-previews.conf
# Grants the paco user exactly enough sudo access to test and reload nginx
# after writing preview configs — see step 6.
SUDOERS_FILE=/etc/sudoers.d/paco

case "$1" in
  configure)
    ;;
  *)
    exit 0
    ;;
esac

# -----------------------------------------------------------------------------
# 1. System user. `adduser` on Debian is itself idempotent when the account
# already exists with matching properties, but check explicitly so the
# intent reads clearly and a `--home` mismatch on some future Debian
# doesn't silently become a no-op we didn't mean.
if ! getent passwd "$PACO_USER" >/dev/null 2>&1; then
  adduser --system --group --home "$PACO_HOME" "$PACO_USER"
fi

# -----------------------------------------------------------------------------
# 2. Directories. `install -d` is already a no-op when the directory exists
# with different ownership/mode — it fixes them to match, which is the
# right behaviour on upgrade too (a mode fixed by hand shouldn't survive).
install -d -m 0750 -o root -g "$PACO_GROUP" "$PACO_ETC"
install -d -m 0750 -o "$PACO_USER" -g "$PACO_GROUP" "$PACO_HOME"
# Owned by paco itself (unlike $PACO_ETC above, which stays root:paco) so
# the unprivileged service user can write preview configs directly — no
# sudo needed for the file-write half of syncPreviewRoutes, only for the
# nginx-test-and-reload half the sudoers rule in step 6 covers.
install -d -m 0750 -o "$PACO_USER" -g "$PACO_GROUP" "$PACO_NGINX_DIR"

# -----------------------------------------------------------------------------
# 2b. The instance password. This file has to exist before the site in step 5
# is enabled: an `auth_basic_user_file` pointing at a missing path does NOT
# fail `nginx -t` — the file is only opened per request — so the failure would
# surface as a 500 on every visit rather than a password prompt.
#
# Generated once and never regenerated, the same rule as APP_SECRET in step 3:
# an upgrade must not silently change the operator's password. Guarded on the
# file being non-empty, not merely existing: `htpasswd -c` creates the file
# before it writes to it, so a failure partway through (below) would leave a
# zero-byte file that `[ -f ]` reports as "already generated" forever after —
# nginx then denies every request, permanently, with no install-time signal
# and no recovery short of deleting the file by hand. A healthy file is never
# empty, so `-s` costs nothing on the ordinary idempotent-upgrade path.
#
# `apt-get install paco` on its own is a supported entry point, so this cannot
# be left to install.sh. install.sh only ever refines what is written here.
if [ ! -s "$NGINX_HTPASSWD" ]; then
  # Alphanumeric only: this gets read off a terminal and typed into a browser
  # prompt by hand, so base64's +/= are a transcription hazard for no gain.
  generated_password=$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | cut -c1-24)

  # A pipeline's exit status in POSIX sh is that of its LAST command, and
  # dash has no `pipefail`: if `openssl rand` fails (missing binary, broken
  # entropy source), `tr` and `cut` both still succeed on empty input and
  # this pipeline exits 0 regardless — `set -e` never fires. Check the
  # result directly instead of trusting $?. Do not simplify this away:
  # without it, a failed `openssl rand` silently hashes the empty string
  # and ships an instance "protected" by a password of nothing.
  if [ -z "$generated_password" ] || [ "${#generated_password}" -ne 24 ]; then
    echo "paco: ERROR — failed to generate the instance password (openssl produced no usable output). Aborting rather than writing an empty or short password hash." >&2
    exit 1
  fi

  umask 027
  # -i keeps the password out of argv, where `ps` would show it to every user
  # on this machine; -B is bcrypt, which is what nginx reads.
  printf '%s' "$generated_password" \
    | htpasswd -i -B -c "$NGINX_HTPASSWD" paco >/dev/null 2>&1
  chown root:www-data "$NGINX_HTPASSWD" 2>/dev/null || true
  chmod 640 "$NGINX_HTPASSWD"

  # Root-only, and deliberately plaintext: install.sh prints it in the closing
  # summary and `paco status` reports that the instance is still on a
  # generated password. `paco password` deletes it once a real one is set.
  printf '%s\n' "$generated_password" > "$PACO_ETC/initial-password"
  chown root:root "$PACO_ETC/initial-password"
  chmod 600 "$PACO_ETC/initial-password"

  # `apt-get install paco` with no install.sh is a supported entry point, and
  # on that path this is the ONLY place an operator is ever told a password
  # exists at all — apt's own output says nothing about it. Without this, the
  # first sign an operator gets is a browser auth prompt they cannot answer:
  # a lockout, not an inconvenience.
  echo "paco: this instance is protected by a generated password. Read it with:"
  echo "        sudo cat /etc/paco/initial-password"
  echo "paco: change it any time with:"
  echo "        sudo paco password"
fi

# -----------------------------------------------------------------------------
# 3. APP_SECRET and paco.env — generated once, ever. This is the step in
# this whole script that must never run twice: regenerating APP_SECRET
# makes every already-stored GitHub token permanently undecryptable
# (AES-256-GCM with a key derived from it — not a hash, so there is no
# "re-derive and compare", only "decrypt with the wrong key and fail").
# Guarded on the file not existing, nothing else.
if [ ! -f "$PACO_ENV" ]; then
  APP_SECRET=$(openssl rand -base64 32)
  umask 077
  # POSTGRES_URL intentionally omits a host: both `postgres` (the
  # postgres.js driver used by Drizzle/lib/db/client.ts) and `pg`
  # (node-postgres, used by pg-boss and the Workflow SDK's world — see
  # instrumentation.ts) reject a connection string of the form
  # `postgres://paco@/paco?host=/var/run/postgresql` outright: passing a
  # non-empty username with an empty host makes the WHATWG `URL` parser
  # both libraries call internally throw `Invalid URL` before either one
  # ever looks at the `?host=` query string — verified directly with both
  # drivers, not assumed. A bare `postgres:///paco` (no username, no host)
  # parses cleanly in both, and both then fall back to the standard libpq
  # `PGHOST` environment variable for the actual socket directory, and to
  # the OS user (peer auth) for the role — which is exactly `paco`, since
  # this file is only ever read by the paco.service process. See
  # .superpowers/sdd/2026-08-05-native-installation/vm-test-report.md for
  # the failing/working transcripts this was verified against on a real
  # Debian-family host.
  cat > "$PACO_ENV" <<EOF
# Generated once by paco's postinst — see the comment there before editing
# APP_SECRET by hand. Regenerating it makes every already-stored GitHub
# token permanently undecryptable.
NODE_ENV=production
PORT=3000
# The app has no authentication of its own — the instance password lives
# entirely in nginx's auth_basic (see the site block below and
# docs/agents' Authentication note). Next's standalone server defaults to
# binding 0.0.0.0 when HOSTNAME is unset, which would let anyone on the
# network reach the app on :3000 directly, bypassing nginx and the
# password it holds. Binding loopback forces every request through
# nginx. This file is written once and never rewritten (see the guard
# above), so it is the one place a fresh install gets this from; an
# already-installed instance is repaired by packaging/paco.service
# instead, which dpkg replaces on every upgrade. An operator who
# deliberately wants the app reachable off-loopback must change this
# knowingly.
HOSTNAME=127.0.0.1
POSTGRES_URL=postgres:///paco
PGHOST=/var/run/postgresql
APP_SECRET=$APP_SECRET
PACO_WORKSPACE_ROOT=$PACO_HOME/workspaces
EOF
  chown root:"$PACO_GROUP" "$PACO_ENV"
  chmod 640 "$PACO_ENV"
  unset APP_SECRET
fi

# -----------------------------------------------------------------------------
# 4. Postgres role and database, created over the Unix socket as the
# `postgres` OS user — never over TCP, so there is no port to expose and no
# password to leak. `paco`'s systemd unit runs as the `paco` OS user
# connecting as the `paco` Postgres role over that same socket, which
# Debian's default `pg_hba.conf` (`local all all peer`) authenticates by OS
# username with no password at all — hence no password anywhere in
# paco.env's POSTGRES_URL above.
#
# Both guarded by an existence check, so a second run — an upgrade — is a
# no-op rather than an error from `CREATE ROLE`/`CREATE DATABASE` on
# something that already exists.
if ! su -s /bin/sh postgres -c "psql -tAc \"SELECT 1 FROM pg_roles WHERE rolname='paco'\"" | grep -q 1; then
  su -s /bin/sh postgres -c "psql -c 'CREATE ROLE paco LOGIN'"
fi
if ! su -s /bin/sh postgres -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='paco'\"" | grep -q 1; then
  su -s /bin/sh postgres -c "createdb -O paco paco"
fi

# -----------------------------------------------------------------------------
# 5. nginx server block. `nginx -t` gates the reload: a package script that
# leaves a broken config un-reloaded and says so is far better than one
# that takes a working site down. The site itself proxies to the app on
# localhost — no domain baked in, matching APP_URL being unset by default
# (Settings, or localhost, decide that at runtime).
cat > "$NGINX_SITE" <<'EOF'
# Installed by paco's postinst, and REWRITTEN by it on every upgrade.
# Do not edit: your changes will be overwritten. This is deliberate — the
# auth_basic directives below are the only thing protecting this instance,
# so an upgrade has to be able to repair them. Put local customisation in
# a separate server block or an include, not here.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # The instance password. Written by postinst on first install and rotated
    # with `paco password`; nginx re-reads it per request, so a change needs
    # no reload. This is the only thing standing between the public internet
    # and this instance — Paco itself has no sign-in.
    auth_basic "Paco";
    auth_basic_user_file /etc/nginx/paco.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
EOF

if [ ! -L "$NGINX_ENABLED" ] && [ ! -e "$NGINX_ENABLED" ]; then
  ln -s "$NGINX_SITE" "$NGINX_ENABLED"
fi

# Delegates into $PACO_NGINX_DIR, which Paco itself owns and writes preview
# server blocks into (see PACO_NGINX_DIR above, and nginx-reload.ts) —
# static and root-owned, unlike the directory it points at, so Paco never
# needs write access under /etc/nginx itself. An `include` glob matching
# zero files (a fresh install, before any preview has ever run) is valid
# nginx config, not an error, so writing this before $PACO_NGINX_DIR has
# anything in it is safe. Regenerated every run, unlike $NGINX_SITE above —
# there is no operator customization to preserve here.
cat > "$NGINX_PREVIEWS_INCLUDE" <<EOF
# Installed by paco's postinst. Do not edit by hand — regenerated every run.
include $PACO_NGINX_DIR/*.conf;
EOF

# The nginx package's own stock site (/etc/nginx/sites-available/default,
# symlinked into sites-enabled by that package) also declares
# `listen 80 default_server;` — two `default_server`s on the same
# `0.0.0.0:80` make `nginx -t` fail outright ("a duplicate default server"),
# which left this site untested and unloaded the first time this ran:
# `nginx -t` failed, the reload was skipped by design (see the comment
# below), and the *old* config — the stock nginx welcome page — kept
# serving, while `curl / ` still returned 200, silently masking the
# failure. Only ever remove the *symlink* here, never the file it points
# to: nginx's own package documents removing it from sites-enabled/ as the
# normal admin step, and its packaging owns sites-available/default's
# lifecycle, not paco's. Guarded on the symlink actually pointing at that
# file, so a from-scratch nginx site an operator has since put there is
# left alone.
if [ -L /etc/nginx/sites-enabled/default ] \
  && [ "$(readlink -f /etc/nginx/sites-enabled/default)" = /etc/nginx/sites-available/default ]; then
  rm -f /etc/nginx/sites-enabled/default
fi

if nginx -t >/tmp/paco-nginx-test.log 2>&1; then
  systemctl reload nginx || systemctl restart nginx
else
  echo "paco: nginx config test failed — leaving the running nginx config untouched." >&2
  cat /tmp/paco-nginx-test.log >&2
  echo "paco: fix the config at $NGINX_SITE and run 'nginx -t' yourself, then 'systemctl reload nginx'." >&2
fi
rm -f /tmp/paco-nginx-test.log

# -----------------------------------------------------------------------------
# 6. Sudoers rule for preview routing, the TLS hook, and self-restart.
# `paco.service` runs as the unprivileged paco user (step 1, and
# paco.service's User=), but apps/web/lib/preview/nginx-reload.ts has to run
# `nginx -t` and `systemctl reload nginx` as root every time a preview starts
# or stops — see $PACO_NGINX_DIR above for the other half (the directory it
# writes the configs themselves into) — and Settings' "Restart now" button
# (apps/web/app/api/admin/restart/route.ts) needs to restart paco.service
# itself once a newly-saved domain needs to reach better-auth's trusted-host
# list. Scoped to exactly those invocations, nothing wider: no shell, no
# arbitrary nginx subcommand, no other systemctl unit.
#
# Regenerated every run rather than guarded on not-existing like $PACO_ENV
# in step 3 — unlike APP_SECRET there is no state to lose by rewriting this,
# and a fixed rule here should always win over a stale or hand-edited one.
#
# Written to a temp file *in the same directory* first — so the `mv` below
# is an atomic rename, never a moment where a partial file is live — and
# validated with `visudo -cf` before it ever occupies $SUDOERS_FILE: a
# malformed sudoers file breaks `sudo` for the entire host, which needs
# console access to recover. `mktemp`'s dot-prefixed name is also skipped
# by sudo's own `#includedir` loading (which ignores names containing "."
# or ending in "~"), so even a temp file left behind by an interrupted
# install is inert. On failure, the temp file is removed, a clear warning
# is printed, and any existing rule is left exactly as it was — never
# replaced with something unvalidated.
sudoers_tmp=$(mktemp /etc/sudoers.d/.paco.XXXXXX)
cat > "$sudoers_tmp" <<'EOF'
# Installed by paco's postinst. Do not edit by hand — regenerated (after
# validation with `visudo -cf`) on every install and upgrade. Grants the
# paco user exactly enough sudo access to reconcile nginx preview routing
# (apps/web/lib/preview/nginx-reload.ts), to obtain a certificate for the
# domain saved in Settings, and to restart its own unit when Settings asks
# for it — nothing wider.
paco ALL=(root) NOPASSWD: /usr/sbin/nginx -t
paco ALL=(root) NOPASSWD: /usr/bin/systemctl reload nginx
# No argument, deliberately: the hook reads the domain from the database
# itself, so there is nothing for the app to pass and nothing to validate
# after the privilege is granted. See packaging/paco-tls-hook's header.
paco ALL=(root) NOPASSWD: /usr/lib/paco/paco-tls-hook
# The unit is named explicitly, not a bare `systemctl restart`, which would
# let a compromised app process restart anything on the host instead of just
# itself. See apps/web/app/api/admin/restart/route.ts.
paco ALL=(root) NOPASSWD: /usr/bin/systemctl restart paco.service
EOF
chmod 0440 "$sudoers_tmp"
if visudo -cf "$sudoers_tmp" >/tmp/paco-sudoers-check.log 2>&1; then
  chown root:root "$sudoers_tmp"
  mv -f "$sudoers_tmp" "$SUDOERS_FILE"
else
  echo "paco: WARNING — the generated sudoers rule failed 'visudo -cf' validation; NOT installing it. Preview routing (nginx -t / systemctl reload nginx as the paco user) will not work until this is fixed by hand." >&2
  cat /tmp/paco-sudoers-check.log >&2
  rm -f "$sudoers_tmp"
fi
rm -f /tmp/paco-sudoers-check.log

# -----------------------------------------------------------------------------
# 6b. Docker group membership for the service account.
#
# Every chat runs in a container, and paco.service talks to
# /var/run/docker.sock as the unprivileged paco user — which the socket only
# permits for members of the `docker` group. Without this the app starts,
# serves its UI, and fails every single chat with a permission error on the
# socket, which reads like a Docker fault rather than a missing group.
#
# Deliberately here rather than only in install.sh, so `apt install paco` on a
# host that already has Docker is as complete as the curl|sh path.
#
# Note this grants the paco user effective root on the host, because access to
# the Docker socket always does. That is inherent to running containers on
# behalf of an agent, not something conferred here; it is stated plainly rather
# than done quietly.
#
# Guarded on the group existing, because docker is Recommends and apt gives no
# guarantee that a recommended package is configured before this one.
# install.sh installs Docker first precisely so this branch is taken; when it
# is not, say so and carry on rather than failing the install — Paco is still
# useful without chats, and the fix is two commands.
#
# Must run BEFORE the restart in step 7: group membership is read when a
# process starts, so a service already running would not pick it up.
#
# The `docker` group is the right discriminator for the branch that does the
# work — it is what usermod needs, and every rootful packaging (docker.io,
# docker-ce) creates it — but it is the wrong discriminator for the branch that
# reports failure, which is what this used to be. A rootless Docker install
# creates no `docker` group at all, so a host with Docker installed, running,
# and serving containers was told "Docker was not found" and sent off to
# install a second one. Hence three states below, not two.
#
# Rootless cannot be supported, so this reports rather than adapts: the sandbox
# bind-mounts the paco user's workspace into the container and runs as that
# user's own uid, while rootless maps container uids through a user namespace,
# so uid 106 inside becomes 100106 on the host (/etc/subuid) and paco cannot
# read its own workspace. docker.io ships no rootless tooling either
# (dockerd-rootless-setuptool.sh and rootlesskit are both absent, and
# docker-ce-rootless-extras is not in Ubuntu's repositories), so there is
# nothing to install that would change the answer.
#
# Detection has to work as root in a maintainer script, which is the awkward
# part: `docker info --format '{{println .SecurityOptions}}'` printing
# `name=rootless` is authoritative, but root's docker(1) talks to
# /var/run/docker.sock, which a rootless install never creates. So DOCKER_HOST
# under /run/user/ and the per-user runtime sockets themselves — visible and
# connectable from root — are the fallbacks. None of this runs on a normal
# rootful host: the group check below short-circuits first.
DOCKER_ROOTLESS_AT=""

# $1 is a DOCKER_HOST to probe with, or "" for the ambient environment. The
# assignment is confined to a subshell so probing one socket cannot change
# where the next call looks. `timeout` when present, because `docker info`
# against a wedged daemon can block and a hanging maintainer script is worse
# than a wrong guess.
# shellcheck disable=SC2030 # confining the assignment to this subshell is the point.
docker_reports_rootless() {
  (
    if [ -n "${1:-}" ]; then
      DOCKER_HOST="$1"
      export DOCKER_HOST
    fi
    if command -v timeout >/dev/null 2>&1; then
      timeout 5 docker info --format '{{println .SecurityOptions}}' 2>/dev/null
    else
      docker info --format '{{println .SecurityOptions}}' 2>/dev/null
    fi
  ) | grep -q 'name=rootless'
}

# shellcheck disable=SC2031 # DOCKER_HOST is only ever set inside the subshell above, never here.
docker_is_rootless() {
  DOCKER_ROOTLESS_AT=""

  if command -v docker >/dev/null 2>&1 && docker_reports_rootless ""; then
    DOCKER_ROOTLESS_AT="${DOCKER_HOST:-unix:///var/run/docker.sock}"
    return 0
  fi

  case "${DOCKER_HOST:-}" in
    */run/user/*)
      DOCKER_ROOTLESS_AT="$DOCKER_HOST"
      return 0
      ;;
  esac

  # A socket at this path with nothing answering is still rootless Docker —
  # rootful never listens under /run/user/ — so it counts as evidence even when
  # `docker info` cannot confirm it.
  for _sock in /run/user/*/docker.sock; do
    [ -S "$_sock" ] || continue
    if command -v docker >/dev/null 2>&1 && docker_reports_rootless "unix://$_sock"; then
      DOCKER_ROOTLESS_AT="unix://$_sock"
      return 0
    fi
    [ -n "$DOCKER_ROOTLESS_AT" ] || DOCKER_ROOTLESS_AT="unix://$_sock"
  done
  [ -n "$DOCKER_ROOTLESS_AT" ]
}

if getent group docker >/dev/null 2>&1; then
  if ! id -nG "$PACO_USER" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
    # Not allowed to abort the install. This script runs under `set -e`, and an
    # unreadable group database or a usermod that fails for any other reason
    # would otherwise leave the package half-configured — a far worse outcome
    # than an install that works for everything except chats and says so.
    if usermod -aG docker "$PACO_USER"; then
      echo "paco: added the '$PACO_USER' user to the 'docker' group so chats can run."
    else
      echo "paco: WARNING - could not add '$PACO_USER' to the 'docker' group. Chats will fail on the Docker socket until this is done by hand:" >&2
      echo "        usermod -aG docker $PACO_USER && systemctl restart paco" >&2
    fi
  fi
elif docker_is_rootless; then
  echo "paco: Docker is installed on this host, but it is running rootless, and Paco cannot use a rootless daemon. Chats cannot run yet." >&2
  echo "        Found at: $DOCKER_ROOTLESS_AT" >&2
  echo "        Why: every chat runs in a container that bind-mounts the '$PACO_USER' user's workspace and runs as that user's own uid. Rootless Docker maps container uids through a user namespace, so a container writing as uid 106 produces files owned by uid 100106 on the host (see /etc/subuid), and '$PACO_USER' cannot read its own workspace. No setting changes that." >&2
  echo "        Paco needs the rootful daemon. That is a separate installation, not a setting on the one you have: it adds a root-owned daemon on /var/run/docker.sock with its own images, containers and volumes, while your rootless daemon keeps running alongside it, untouched, and keeps its own." >&2
  echo "        If that is what you want, chats work after:" >&2
  echo "          apt-get install -y docker.io && dpkg-reconfigure paco" >&2
  echo "        Everything else about this install is fine; only chats are affected." >&2
else
  echo "paco: Docker was not found, so chats cannot run yet. Install it and reconfigure paco:" >&2
  echo "        apt-get install -y docker.io && dpkg-reconfigure paco" >&2
fi

# -----------------------------------------------------------------------------
# 7. Enable and (re)start the service. `daemon-reload` picks up a changed
# unit file on upgrade; `restart` (not `try-restart`) so an upgrade always
# ends up running the new version, not the old one left running from
# before the package was replaced.
systemctl daemon-reload

# The unit's `After=docker.service` (packaging/paco.service) orders boot, and
# nothing else: a manual `systemctl restart` — which is exactly what the next
# line is — starts the unit immediately regardless of ordering, and `Wants=`
# pulling docker.service in does not make this command wait for it either.
#
# That matters here specifically. This script runs during `apt install` and
# `apt upgrade`, and an upgrade that includes docker.io restarts Docker in the
# same apt run; restarting Paco in that window is precisely the race the
# ordering above exists to remove, reintroduced by hand. So ask for Docker
# first and give it a moment to be up before Paco starts talking to its socket.
#
# Best-effort throughout, because this script runs under `set -e` and none of
# it is worth failing an install over: `is-enabled` is only consulted so a host
# where the operator deliberately disabled Docker is not overridden, an absent
# unit makes every branch a no-op, and a Docker that refuses to start still
# leaves a working Paco whose chats explain themselves.
if systemctl is-enabled docker.service >/dev/null 2>&1; then
  if ! systemctl is-active docker.service >/dev/null 2>&1; then
    echo "paco: waiting for docker.service before restarting paco."
    systemctl start docker.service >/dev/null 2>&1 || true
  fi
fi

systemctl enable paco.service
systemctl restart paco.service

# -----------------------------------------------------------------------------
# 8. The bundled Claude Code CLI. build-deb.sh installs it into
# /usr/lib/paco/node and exposes it as /usr/bin/claude (see
# packaging/claude-wrapper.sh) — unlike gh below, this is not optional and
# not something the operator installs: its absence here means the package
# itself was built or staged wrong, and every chat will fail with no
# `claude` to run. Loud rather than silent, same reasoning as the nginx
# test above: a package script that reports a broken install clearly is far
# better than one that reports success and lets it surface as a confusing
# first-chat failure. `paco status` also reports this (see scripts/paco).
if [ ! -x /usr/bin/claude ]; then
  echo "paco: WARNING — the bundled Claude Code CLI was not found at /usr/bin/claude. Every chat will fail until this is fixed, no matter what credential is saved in Settings. This means the .deb was built or staged incorrectly; try 'apt-get install --reinstall paco', or rebuild the package (packaging/build-deb.sh)." >&2
fi

# -----------------------------------------------------------------------------
# 9. gh is a Recommends (see control), so apt installs it by default and this
# warning is normally unreachable. It was a Suggests until 0.2.2, on the
# premise that gh "ships from GitHub's own APT repository, not Debian's" —
# which is not true on the distributions this package targets: Ubuntu carries
# it in `universe` (noble has 2.45.0), and every command Paco runs — `api`,
# `repo clone`, `repo create`, `auth status`, `pr create` — is far older than
# that. The consequence of the wrong tier was that `apt install paco` and
# install.sh both skipped it, and connecting a GitHub account failed on a
# server that had followed the documented install exactly.
#
# Recommends rather than Depends, matching docker.io: an operator may have
# gh from GitHub's own repository, or `universe` disabled, and neither should
# make Paco refuse to install.
#
# Reaching this now means --no-install-recommends, or gh removed afterwards.
if ! command -v gh >/dev/null 2>&1; then
  echo "paco: the 'gh' CLI was not found on PATH. Connecting a GitHub account, cloning a repository and opening a pull request all go through it, and will fail until it is installed:" >&2
  echo "        sudo apt-get install -y gh" >&2
  echo "paco: if that reports no such package, this host has 'universe' disabled; GitHub's own repository is the alternative: https://github.com/cli/cli/blob/trunk/docs/install_linux.md" >&2
fi

echo "paco: installed. Open http://<this host>/ to finish setup."

exit 0
